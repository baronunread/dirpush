{
  "name": "launch",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "bin": {
    "launch": "src/cli.ts"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts serve",
    "launch": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "registry:build": "bun scripts/build-registry.ts",
    "site:build": "bun scripts/build-site.ts",
    "site:serve": "bun scripts/serve-site.ts",
    "site:deploy": "bun scripts/build-site.ts && wrangler deploy",
    "repo:check": "bun scripts/check-repo.ts",
    "verify": "bun run repo:check && bun run typecheck && bun test src"
  },
  "description": "Local-first directory launch tool: verified directory registry, job queue and dashboard for your coding agent"
}
