{
  "name": "dirpush",
  "type": "module",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "bin": {
    "dirpush": "bin/dirpush.cjs"
  },
  "scripts": {
    "dev": "bun --watch src/cli.ts serve",
    "launch": "bun src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "registry:build": "bun scripts/build-registry.ts",
    "site:build": "bun scripts/build-site.ts",
    "site:serve": "bun scripts/serve-site.ts",
    "site:deploy": "bun scripts/build-site.ts && wrangler deploy",
    "repo:check": "bun scripts/check-repo.ts",
    "verify": "bun run repo:check && bun run typecheck && bun test src"
  },
  "description": "Submit your product to startup and SaaS directories with your own coding agent. Verified directory registry, job queue and local dashboard.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/baronunread/dirpush.git"
  },
  "homepage": "https://dirpush.com",
  "version": "0.2.0",
  "keywords": [
    "directories",
    "startup",
    "saas",
    "launch",
    "backlinks",
    "agent",
    "claude-code",
    "codex",
    "agent-browser",
    "cli"
  ],
  "files": [
    "bin/",
    "src/",
    "!src/**/*.test.ts",
    "drizzle/",
    "examples/",
    "registry/directories/",
    "registry/LICENSE",
    "scripts/ab",
    "scripts/google-login",
    "scripts/show-browser",
    "scripts/check-listings",
    ".agents/skills/dirpush/",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "bugs": "https://github.com/baronunread/dirpush/issues",
  "fledgling": {
    "provider": "github",
    "workflow": "release.yml",
    "environment": "npm",
    "publish": true
  }
}
