#!/bin/sh
# The only way agents should drive the browser: persistent profile + Google-services block.
# The profile holds the human's Google session (for "Continue with Google"). Everything Google
# other than the sign-in pages is unreachable, so a confused or prompt-injected agent can't open
# Gmail, Drive, account settings, passwords or payments. Routes vanish when the browser restarts,
# so they are (re)applied on every call (~10 ms each). accounts.google.com stays open: OAuth needs it.
set -e
# Your launch data: LAUNCH_HOME, else the repo itself for a git checkout, else ~/.dirpush (installed package).
PKG="$(cd "$(dirname "$0")/.." && pwd)"
if [ -n "$LAUNCH_HOME" ]; then H="$LAUNCH_HOME"; elif [ -d "$PKG/.git" ]; then H="$PKG"; else H="$HOME/.dirpush"; fi
mkdir -p "$H/data" && cd "$H"
# Real Chrome, not Chrome for Testing: Google refuses sign-in in the testing build, and the human
# signs in once in this same profile with `scripts/google-login`.
CHROME="/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"
# Always headed: submissions regularly need the human to click something in this window.
# The worker's session: AB_SESSION, else its LAUNCH_WORKER name, else "default" (abSession in src/browser.ts).
# Parallel workers share the one Chrome below, each in its own pinned tab. AB_PROFILE runs a throwaway profile
# instead (no Google login there).
S="${AB_SESSION:-${LAUNCH_WORKER:-default}}"
AB="agent-browser --headed --session $S --profile ${AB_PROFILE:-$H/data/browser-profile} --executable-path"
# `launch browser start` already runs this profile (Google services blocked by its PAC script): attach to it
# instead of launching a second Chrome on the same profile.
PORT="${LAUNCH_BROWSER_PORT:-9222}"
up() { curl -s -m 1 "http://127.0.0.1:$PORT/json/version" >/dev/null 2>&1; }
# The real profile always runs as that dedicated Chrome. Launching it through agent-browser instead relaunches Chrome
# on every call (losing tabs and filled forms), so start it here when it's down (e.g. after a Google sign-in).
if [ -z "$AB_PROFILE" ] && ! up && [ "$1" != "close" ]; then
  agent-browser --session "$S" close >/dev/null 2>&1 || true
  bun "$PKG/src/cli.ts" browser start >/dev/null 2>&1 || { echo "couldn't start the agents' Chrome: run 'dirpush browser start' and read its error" >&2; exit 1; }
fi
if [ -z "$AB_PROFILE" ] && up; then
  PIN=""
  if [ "$S" != default ]; then
    # A named session gets a tab of its own, once per Chrome launch (the marker holds that Chrome's id), and stays
    # pinned to it: it never drifts onto another worker's tab. A closed tab fails with tab_gone: 'dirpush ab tab new'.
    PIN="--pin-tab"
    ID=$(curl -s -m 1 "http://127.0.0.1:$PORT/json/version" | sed -n 's#.*devtools/browser/\([^"]*\)".*#\1#p')
    M="$H/data/ab-sessions/$S"
    if [ "$(cat "$M" 2>/dev/null)" != "$ID" ]; then
      agent-browser --session "$S" --cdp "$PORT" tab new >/dev/null # unpinned: a pinned attach opens a second, blank tab
      mkdir -p "$H/data/ab-sessions" && printf '%s\n' "$ID" > "$M"
    fi
  fi
  if [ "$1" = close ]; then
    # Only ends this session's connection; agent-browser's own "Browser closed" reads like the shared Chrome went down.
    agent-browser --session "$S" --cdp "$PORT" close >/dev/null 2>&1 || true
    echo "✓ Disconnected session $S. The agents' Chrome and its tabs stay open."
    exit 0
  fi
  exec perl -e 'alarm shift; exec @ARGV or die "cannot run $ARGV[0]: $!\n"' "${AB_TIMEOUT:-90}" agent-browser --session "$S" --cdp "$PORT" $PIN "$@"
fi
for host in mail.google.com gmail.com www.gmail.com inbox.google.com \
  drive.google.com drive.usercontent.google.com docs.google.com sheets.google.com slides.google.com forms.google.com \
  photos.google.com keep.google.com calendar.google.com contacts.google.com \
  myaccount.google.com security.google.com myactivity.google.com passwords.google.com \
  pay.google.com payments.google.com wallet.google.com takeout.google.com admin.google.com \
  script.google.com console.cloud.google.com cloud.google.com console.developers.google.com \
  chromewebstore.google.com chrome.google.com; do
  $AB "$CHROME" network route "*://$host/*" --abort >/dev/null 2>&1 || true
done
# The Google Account settings live under accounts.google.com too; only sign-in/consent paths are needed.
for path in "b/*/ManageAccount*" "ManageAccount*" "security*" "*/personal-info*" "*/data-and-privacy*"; do
  $AB "$CHROME" network route "*://accounts.google.com/$path" --abort >/dev/null 2>&1 || true
done
# Per-call time limit (AB_TIMEOUT seconds, default 90): a hung call (seen on file uploads) must not freeze a worker.
# Exit 142 = timed out; then run `dirpush ab close` and start over from the last checkpoint.
exec perl -e 'alarm shift; exec @ARGV or die "cannot run $ARGV[0]: $!\n"' "${AB_TIMEOUT:-90}" $AB "$CHROME" "$@"
